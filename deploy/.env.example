# ============================================================
# ABAX Gantt — Variables de Entorno
# ============================================================
# Copiar a .env y ajustar valores antes de iniciar

# ── Modo de instalación ──
# bundled = todo incluido (PostgreSQL + Authentik internos)
# external = infraestructura existente (PostgreSQL + Authentik externos)
AUTH_MODE=external

# ── Imagen Docker ──
# Local: abax-gantt:latest
# CI/GHCR: ghcr.io/<owner>/<repo>:<tag>
ABAX_IMAGE=abax-gantt:latest

# ── PostgreSQL (requerido en ambos modos) ──
# Para modo external, usar URL de la instancia existente
DATABASE_URL=postgresql://abax:abax_secret@localhost:5432/abax

# ── Authentik OIDC (requerido en ambos modos) ──
AUTHENTIK_ISSUER=https://auth.example.com/application/o/abax-gantt/
AUTHENTIK_CLIENT_ID=abax-gantt-spa
AUTHENTIK_JWKS_URL=https://auth.example.com/application/o/abax-gantt/jwks/

# ── Grupo de administradores en Authentik ──
ADMIN_GROUP=abax-admins

# ── Solo modo bundled ──
# DB_PASSWORD=abax_secret
# AUTHENTIK_SECRET_KEY=<generar clave segura>
# DEFAULT_ADMIN_EMAIL=admin@abax.local
# DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ── Puerto del servidor (default: 8000) ──
# PORT=8000

# ── Storage de adjuntos (default: ./data/attachments) ──
# STORAGE_PATH=/app/data/attachments

# ── Frontend build ──
# Para root: VITE_BASE_PATH=/ y VITE_API_BASE_URL vacío.
# Para subpath /abax-gantt: VITE_BASE_PATH=/abax-gantt/ y VITE_API_BASE_URL=/abax-gantt.
# VITE_AUTHENTIK_AUTHORITY=https://auth.example.com/application/o/abax-gantt/
# VITE_AUTHENTIK_CLIENT_ID=abax-gantt-spa
# VITE_AUTHENTIK_REDIRECT_URI=http://localhost:8000/auth/callback
# VITE_AUTHENTIK_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/login
# VITE_BASE_PATH=/
# VITE_API_BASE_URL=/abax-gantt
