{
  "name": "abax-gantt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix poc run dev",
    "build": "npm --prefix poc run build",
    "lint": "npm --prefix poc run lint",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "functions:projects": "npx supabase functions serve api-projects --env-file .env",
    "functions:wbs": "npx supabase functions serve api-wbs --env-file .env",
    "functions:wbs-node": "npx supabase functions serve api-wbs-node --env-file .env",
    "functions:dependencies": "npx supabase functions serve api-dependencies --env-file .env",
    "functions:dependency": "npx supabase functions serve api-dependency --env-file .env",
    "functions:assignees": "npx supabase functions serve api-assignees --env-file .env",
    "functions:assignee": "npx supabase functions serve api-assignee --env-file .env",
    "functions:admin-users": "npx supabase functions serve api-admin-users --env-file .env",
    "functions:users": "npx supabase functions serve api-users --env-file .env",
    "functions:admin-user": "npx supabase functions serve api-admin-user --env-file .env",
    "functions:backlog": "npx supabase functions serve api-backlog --env-file .env",
    "functions:wbs-schedule": "npx supabase functions serve api-wbs-schedule --env-file .env",
    "functions:wbs-progress": "npx supabase functions serve api-wbs-progress --env-file .env",
    "functions:timesheet": "npx supabase functions serve api-timesheet --env-file .env",
    "functions:wbs-move": "npx supabase functions serve api-wbs-move --env-file .env",
    "functions:summary": "npx supabase functions serve api-summary --env-file .env",
    "functions:admin-project-types": "npx supabase functions serve api-admin-project-types --env-file .env",
    "functions:admin-project-type": "npx supabase functions serve api-admin-project-type --env-file .env",
    "functions:attachments": "npx supabase functions serve api-attachments --env-file .env",
    "functions:attachment": "npx supabase functions serve api-attachment --env-file .env",
    "functions:export": "npx supabase functions serve api-export --env-file .env",
    "functions:reports": "npx supabase functions serve api-reports --env-file .env",
    "functions:kpi": "npx supabase functions serve api-kpi --env-file .env",
    "functions:import": "npx supabase functions serve api-import --env-file .env",
    "functions:mcp": "npx supabase functions serve api-mcp --env-file .env",
    "check:functions": "deno check supabase/functions/api-projects/index.ts supabase/functions/api-wbs/index.ts supabase/functions/api-wbs-node/index.ts supabase/functions/api-dependencies/index.ts supabase/functions/api-dependency/index.ts supabase/functions/api-assignees/index.ts supabase/functions/api-assignee/index.ts supabase/functions/api-admin-users/index.ts supabase/functions/api-users/index.ts supabase/functions/api-admin-user/index.ts supabase/functions/api-backlog/index.ts supabase/functions/api-wbs-schedule/index.ts supabase/functions/api-wbs-progress/index.ts supabase/functions/api-timesheet/index.ts supabase/functions/api-wbs-move/index.ts supabase/functions/api-summary/index.ts supabase/functions/api-admin-project-types/index.ts supabase/functions/api-admin-project-type/index.ts supabase/functions/api-attachments/index.ts supabase/functions/api-attachment/index.ts supabase/functions/api-export/index.ts supabase/functions/api-reports/index.ts supabase/functions/api-kpi/index.ts supabase/functions/api-import/index.ts supabase/functions/api-mcp/index.ts",
    "check": "npm run check:functions && npm run lint",
    "smoke:frontend": "npm --prefix poc run test",
    "smoke:backend": "npm run test:integration",
    "smoke:e2e": "npm --prefix poc run test:e2e",
    "serve:core": "npx supabase functions serve api-projects api-wbs api-wbs-node api-dependencies api-dependency api-assignees api-assignee api-users api-backlog api-wbs-schedule api-wbs-progress api-wbs-move api-summary api-attachments api-attachment api-reports --env-file .env",
    "test:unit": "deno test --env-file=.env supabase/functions/_shared/tests/*.test.ts --allow-env --allow-net",
    "test:integration": "deno test --env-file=.env supabase/tests/integration.test.ts --allow-env --allow-net --allow-read --allow-run=docker",
    "test": "deno test --env-file=.env supabase/functions/_shared/tests/*.test.ts supabase/tests/integration.test.ts --allow-env --allow-net --allow-read --allow-run=docker",
    "migration:openproject": "node tools/openproject-migration.mjs",
    "migration:openproject:write": "node tools/openproject-migration.mjs --write",
    "migration:openproject:apply": "deno run --allow-read --allow-env --allow-net tools/openproject-import.ts --apply",
    "prepare": "husky"
  },
  "devDependencies": {
    "supabase": "^2.98.2"
  }
}
